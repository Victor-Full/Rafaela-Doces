---
import type { ImageMetadata } from 'astro';
import ProductPhoto from './ProductPhoto.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import { categories, maxOrderQuantity } from '../data/menu';
import type { MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
  photo: { src: string };
  original: ImageMetadata;
}

const { item, photo, original } = Astro.props;
const category = categories.find(({ id }) => id === item.category);
const quantityId = `quantidade-${item.id}`;
const limitId = `${quantityId}-limite`;
---

<li class="menu-card" data-category={item.category} data-name={item.name} id={item.id}>
  <ProductPhoto crop={item.crop} photo={photo} original={original} />
  <div class="menu-card-body">
    <p class="menu-card-category">{category?.name}</p>
    <h3>{item.name}</h3>
    <div class="menu-card-actions" data-product-order data-order-name={item.name} data-order-question={item.whatsappQuestion}>
      <div class="order-quantity" data-order-quantity hidden>
        <label for={quantityId}>Quantidade</label>
        <div class="quantity-stepper">
          <button type="button" data-quantity-decrease aria-label={`Diminuir quantidade de ${item.name}`} disabled>−</button>
          <input id={quantityId} data-quantity-input type="number" inputmode="numeric" autocomplete="off"
            min="1" max={maxOrderQuantity} step="1" value="1" required aria-label={`Quantidade de ${item.name}`}
            aria-describedby={limitId} />
          <button type="button" data-quantity-increase aria-label={`Aumentar quantidade de ${item.name}`}>+</button>
        </div>
        <p id={limitId} class="quantity-limit" data-quantity-limit hidden>
          Para mais de {maxOrderQuantity} unidades, combine pelo WhatsApp.
        </p>
        <p class="sr-only" role="status" data-quantity-status></p>
      </div>
      <WhatsAppLink label="Consultar" product={item} class="menu-card-link" />
    </div>
  </div>
</li>

<script>
  import { maxOrderQuantity, menuOrderMessage } from '../data/menu';

  for (const order of document.querySelectorAll<HTMLElement>('[data-product-order]')) {
    const control = order.querySelector<HTMLElement>('[data-order-quantity]');
    const input = order.querySelector<HTMLInputElement>('[data-quantity-input]');
    const decrease = order.querySelector<HTMLButtonElement>('[data-quantity-decrease]');
    const increase = order.querySelector<HTMLButtonElement>('[data-quantity-increase]');
    const limit = order.querySelector<HTMLElement>('[data-quantity-limit]');
    const status = order.querySelector<HTMLElement>('[data-quantity-status]');
    const link = order.querySelector<HTMLAnchorElement>('.menu-card-link');
    const { orderName, orderQuestion } = order.dataset;

    if (!control || !input || !decrease || !increase || !limit || !status || !link || !orderName || !orderQuestion) continue;

    const product = { name: orderName, whatsappQuestion: orderQuestion };
    const url = new URL(link.href);
    let quantity = 1;

    const updateQuantity = (next: number, announce = false) => {
      const previous = quantity;
      quantity = Math.min(maxOrderQuantity, Math.max(1, next));
      const reachedLimit = quantity === maxOrderQuantity;
      decrease.disabled = quantity === 1;
      increase.disabled = reachedLimit;
      limit.hidden = !reachedLimit;
      if (reachedLimit && previous !== maxOrderQuantity) {
        status.textContent = limit.textContent;
      } else if (announce) {
        status.textContent = `Quantidade de ${product.name} alterada para ${quantity}.`;
      }
      url.search = `?text=${encodeURIComponent(menuOrderMessage(product, quantity))}`;
      link.href = url.href;
    };

    const step = (change: number) => {
      updateQuantity(quantity + change, true);
      input.value = String(quantity);
    };

    const syncInput = () => {
      if (input.validity.rangeOverflow) {
        input.value = String(maxOrderQuantity);
      }
      if (input.validity.valid && Number.isSafeInteger(input.valueAsNumber)) {
        updateQuantity(input.valueAsNumber);
      }
    };

    decrease.addEventListener('click', () => step(-1));
    increase.addEventListener('click', () => step(1));
    input.addEventListener('input', syncInput);
    input.addEventListener('change', syncInput);
    input.addEventListener('blur', () => {
      input.value = String(quantity);
    });

    syncInput();
    control.hidden = false;
  }
</script>
