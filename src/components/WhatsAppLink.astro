---
import Icon from './Icon.astro';
import { menuOrderMessage } from '../data/menu';
import type { OrderProduct } from '../data/menu';
import { whatsappLink } from '../data/site';

interface Props {
  label: string;
  product?: OrderProduct;
  class?: string;
}

const { label, product, class: className } = Astro.props;
const message = product ? menuOrderMessage(product) : undefined;
---

<a class={className} href={whatsappLink(message)}
  target="_blank" rel="noopener noreferrer"
  aria-label={product ? `${label} sobre ${product.name} pelo WhatsApp` : undefined}>
  <span class="whatsapp-mark">
    <Icon name="whatsapp" size={25} />
  </span>
  <span>{label}</span>
</a>
